# Contact form SMTP relay (POST /api/contact). Copy to .env.local and fill in.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional: recipient inbox (defaults to the site contact email),
# and From header (defaults to SMTP_USER).
CONTACT_TO=
CONTACT_FROM=

# ---- SEO / Google Search Console ----
# Canonical site URL used for sitemap, robots, canonicals and structured data.
NEXT_PUBLIC_SITE_URL=https://roadsafetysolutions.in
# Paste the content value from Search Console > Settings > Ownership
# verification (HTML tag method). Enables <meta name="google-site-verification">.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
